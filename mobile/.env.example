# API (optional — app auto-detects emulator / LAN)
# EXPO_PUBLIC_API_URL=http://10.0.2.2:3001/api

# --- SSO feature flags (restart Expo after changes) ---
EXPO_PUBLIC_SSO_GOOGLE=true
EXPO_PUBLIC_SSO_APPLE=false

# Dev tokens when Google client IDs are empty (backend AUTH_DEV_SSO=true)
EXPO_PUBLIC_AUTH_DEV_SSO=1

# Production Google OAuth client IDs
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
# Android OAuth client — required for real Google login on Android/Expo Go
# Expo Go package: host.exp.exponent (+ Expo SHA-1)
# Your app package: com.aaspaas.app
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
