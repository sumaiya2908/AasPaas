# Copy to .env and adjust if needed
DATABASE_URL="postgresql://aaspaas:aaspaas@localhost:5432/aaspaas?schema=public"
JWT_SECRET="change-me"
PORT=3001

# --- Auth / SSO ---
# Local Expo Go: keep true so mobile can use Continue with Google/Apple without real tokens.
# Set false in production.
AUTH_DEV_SSO=true

# Google: comma-separated OAuth client IDs allowed as token `aud`
# (web + iOS + Android client IDs from the same Google Cloud project)
# Google Web OAuth client (not Android — Expo uses API callback)
GOOGLE_CLIENT_IDS=
GOOGLE_CLIENT_SECRET=
# Add this exact URI in Google Cloud → Web client → Authorised redirect URIs
GOOGLE_REDIRECT_URI=http://127.0.0.1:3001/api/auth/google/callback
APPLE_CLIENT_ID=com.aaspaas.app

# --- RAG ---
RAG_VECTOR_DIMS=384
RAG_EMBEDDING_PROVIDER=local
# Admin key for POST /rag/seed and /rag/reindex (required in production)
RAG_ADMIN_KEY=dev-local-change-me
# RAG_EMBEDDING_PROVIDER=openai
# OPENAI_API_KEY=
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# --- Production hardening ---
# CORS_ORIGINS=https://your-app.com,exp://your-app
# RATE_LIMIT_PER_MIN=120

CITY_IMPORT_MIN_POPULATION=0
CITY_SEARCH_LIMIT=10
